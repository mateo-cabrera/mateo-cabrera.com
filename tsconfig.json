{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "src/**/*"],
	"exclude": ["dist", "build", "agent", ".agents", ".claude", ".svelte-kit", "node_modules", "scripts"],
	"compilerOptions": {
		"strictNullChecks": true,
		"allowJs": true,
		"checkJs": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	}
}
