---
import Icon from './Icon.astro';
import ProjectMedia from './ProjectMedia.astro';
import type { Project } from '~/data/types';

interface Props {
	project: Project;
	variant?: 'featured' | 'index';
	priority?: boolean;
}

const { project, variant = 'index', priority = false } = Astro.props;

/** L'enseigne de la boutique : chaque type de projet a sa couleur d'émail. */
const awning: Record<Project['type'], string> = {
	Professionnel: 'bg-indigo text-enamel-face',
	Personnel: 'bg-vermilion text-enamel-face',
	Académique: 'bg-chrome text-ink'
};

const featured = variant === 'featured';
/** itch.io est une démo jouable, pas un lien de plus : elle se nomme comme telle. */
const isPlayable = project.demo.includes('itch.io');
/**
 * Trois puces au maximum sur une vedette, deux sur une carte d'index.
 *
 * Les trois vedettes partagent une rangée de `lg:grid-cols-3` et chaque carte
 * porte `h-full` : la plus haute impose sa hauteur aux deux autres. Sans borne,
 * une quatrième puce écrite sur une seule fiche allongeait les trois, et la
 * rangée dépassait la hauteur du viewport sur un portable. La borne est ici et
 * pas dans la donnée parce que c'est la mise en page qui la dicte.
 */
const bullets = project.bullets.slice(0, featured ? 3 : 2);
---

<article
	class="plate hoverable-lift border-ink bg-ground flex h-full flex-col overflow-hidden border-2"
>
	<ProjectMedia
		image={project.image}
		poster={project.poster}
		alt={project.alt}
		orientation={project.orientation}
		priority={priority}
	/>

	{/* L'auvent : bandeau émaillé pleine largeur qui nomme la boutique. */}
	<div
		class:list={[
			'border-ink flex items-center justify-between gap-3 border-b-2 px-4 py-2',
			awning[project.type]
		]}
	>
		<span class="admin">{project.type}</span>
		{
			/* 90 % et pas moins : l'auvent le plus clair des trois est le vermillon,
			   et l'émail y tombe à 4.14:1 dès 80 % d'opacité, sous le seuil AA de
			   4.5 pour du 12 px. À 90 % le pire des trois fonds tient 4.94:1 et la
			   hiérarchie entre le type et la catégorie reste lisible. */
		}
		<span class="admin opacity-90">
			{project.category === 'Projets Web' ? 'Web' : 'Jeu vidéo'}
		</span>
	</div>

	<div class="flex flex-1 flex-col p-4 sm:p-5">
		<h3 class:list={['lettering stretch-sign text-ink', featured ? 'text-plate' : 'text-sign']}>
			{project.title}
		</h3>

		{
			project.metrics && (
				<dl class="border-ink-line mt-3.5 flex flex-wrap gap-x-5 gap-y-2 border-y-2 py-3">
					{project.metrics.map((metric) => (
						<div>
							<dt class="sr-only">{metric.label}</dt>
							<dd>
								<span class="lettering nums-tabular text-sign text-vermilion-deep block">
									{metric.value}
								</span>
								<span class="admin text-ink-3 block">{metric.label}</span>
							</dd>
						</div>
					))}
				</dl>
			)
		}

		<ul class="text-small text-ink-2 mt-3.5 space-y-2">
			{
				bullets.map((bullet) => (
					<li class="grid grid-cols-[10px_1fr] gap-2.5">
						<span aria-hidden="true" class="bg-vermilion mt-[0.55em] block size-[6px]" />
						<span>{bullet}</span>
					</li>
				))
			}
		</ul>

		<ul class="mt-4 flex flex-wrap gap-1.5">
			{
				project.tags.map((tag) => (
					<li class="admin border-ink-line bg-ground-sunk text-ink-2 border px-2 py-1">{tag}</li>
				))
			}
		</ul>

		{
			(project.demo || project.github) && (
				<div class="mt-auto flex flex-wrap gap-2 pt-5">
					{project.demo && (
						<a
							href={project.demo}
							target="_blank"
							rel="noopener noreferrer"
							class="plate pressable bg-ink text-small text-enamel-face hover:bg-indigo inline-flex items-center gap-2 px-3.5 py-2 font-extrabold"
						>
							<Icon name={isPlayable ? 'itch' : 'external'} size={15} />
							{isPlayable ? 'Jouer' : 'Voir le site'}
						</a>
					)}
					{project.github && (
						<a
							href={project.github}
							target="_blank"
							rel="noopener noreferrer"
							class="plate pressable border-ink bg-ground text-small text-ink hover:bg-chrome inline-flex items-center gap-2 border-2 px-3.5 py-[7px] font-bold"
						>
							<Icon name="github" size={15} />
							Code
						</a>
					)}
				</div>
			)
		}
	</div>
</article>
