---
import Icon from './Icon.astro';
import CopySwap from './CopySwap.astro';
import SectionHead from './SectionHead.astro';
import { profile, socials, cv } from '~/data/profile';
---

{/* Le comptoir : la page se ferme sur une vraie ancre, pas sur un dégradé. */}
<section id="contact" class="border-ink bg-vermilion text-enamel-face border-t-2">
	<div class="mx-auto w-full max-w-[1240px] px-5 py-16 sm:px-8 sm:py-20">
		<SectionHead title="Contact" note={profile.location} tone="enamel" />

		<p class="text-sign max-w-[46ch] font-semibold">{profile.tagline}</p>

		<div class="mt-8 flex flex-wrap items-center gap-3">
			<a
				href={cv.href}
				download={cv.filename}
				class="plate pressable lettering stretch-sign border-ink bg-chrome text-plate text-ink hover:bg-ground inline-flex items-center gap-3 border-2 px-6 py-4"
			>
				<Icon name="download" size={22} />
				{cv.label}
			</a>

			{
				/* La route /cv était indexable et sans aucun lien entrant : c'est la
			    source du PDF, elle doit être atteignable. */
			}
			<a
				href={cv.route}
				class="admin text-enamel-face decoration-enamel-face/60 hover:decoration-enamel-face inline-block py-3.5 underline underline-offset-4 transition-colors duration-200"
			>
				Voir le CV en ligne
			</a>
		</div>

		{
			/* Une ligne par canal. Rien n'y est jamais coupé par « … » : à 320 px,
			   l'ancienne troncature réduisait les trois identifiants à « mateo-… »,
			   et l'adresse à 390 px perdait son domaine. En dessous de `sm` le
			   libellé passe au-dessus de l'identifiant, ce qui lui rend toute la
			   largeur ; l'adresse peut se couper après son « @ », et seulement là
			   tant qu'il reste de la place.

			   La flèche dit « quitte le site » : seuls les liens ouverts dans un
			   nouvel onglet la portent. L'adresse ne quitte rien, elle se copie.

			   Au survol l'identifiant se souligne, comme « Voir le CV en ligne » au
			   même comptoir : le lettrage reste celui de l'émail, il ne vire pas au
			   jaune de chrome (The Region Rule). */
		}
		<ul class="border-enamel-face/35 mt-12 border-t-2">
			{
				socials.map((social) => {
					const email = social.id === 'email';
					const [local, domain] = social.handle.split('@');
					return (
						<li class="border-enamel-face/35 border-b-2">
							<a
								href={social.href}
								target={email ? null : '_blank'}
								rel={email ? null : 'noopener noreferrer'}
								data-copy-email={email ? '' : null}
								class="group flex items-center gap-4 py-4 sm:gap-6"
							>
								<Icon name={social.id === 'email' ? 'mail' : social.id} size={22} />
								<span class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-center sm:gap-6">
									<span class="admin shrink-0 sm:w-32">{social.label}</span>
									<span class="stretch-sign text-sign font-bold [overflow-wrap:anywhere] decoration-2 underline-offset-4 group-hover:underline group-active:underline">
										{email ? (
											<CopySwap copied="Adresse copiée">
												{local}@<wbr />
												{domain}
											</CopySwap>
										) : (
											social.handle
										)}
									</span>
								</span>
								{!email && (
									<span
										aria-hidden="true"
										class="shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-1"
									>
										<Icon name="external" size={16} />
									</span>
								)}
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
