	| 'github'
	| 'mail'
	| 'linkedin'
	| 'download'
	| 'external'
	| 'itch'
	| 'steam'
	| 'pin'
	| 'play'
	| 'pause';

interface Props {
	name: IconName;
	size?: number;
}

const { name, size = 16 } = Astro.props;

