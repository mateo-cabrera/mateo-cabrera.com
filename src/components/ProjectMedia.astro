---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { isLocalImage } from '~/lib/media';
import type { MediaSource } from '~/data/types';

interface Props {
	image: MediaSource;
	poster?: ImageMetadata;
	alt: string;
	orientation?: 'landscape' | 'portrait';
	priority?: boolean;
}

const { image, poster, alt, orientation = 'landscape', priority = false } = Astro.props;

// Un test sur l'extension plutôt qu'un simple « c'est une chaîne » : une URL
// d'asset peut aussi être un svg, et le rendre dans un <video> le ferait
// disparaître sans erreur.
const video = typeof image === 'string' && /\.(webm|mp4)(\?|$)/i.test(image) ? image : null;

/**
 * Le cadre a un ratio fixe et le média est contenu, jamais recadré.
 *
 * Un ratio fixe supprime tout décalage de mise en page au chargement ; le
 * `contain` évite de rogner l'interface d'une capture produit, ce qui est
 * précisément ce qu'un visiteur vient regarder. Les captures vont de 1.53 à
 * 1.94 de ratio : elles sont montées sur une plaque, comme un tirage.
 */
const frame = orientation === 'portrait' ? 'aspect-[4/5]' : 'aspect-[16/10]';

/**
 * Les largeurs candidates suivent la grille réelle, pas des paliers ronds :
 * une colonne sur trois dans un conteneur de 1240 px fait 376 px, une sur deux
 * en tablette environ 340, et pleine largeur en mobile jusqu'à 600. Les deux
 * dernières valeurs sont les versions 2x. `enhanced-img` dérivait tout ça seul ;
 * `<Picture>` ne le fait pas, et sans ces valeurs le srcset ne sert à rien.
 */
const widths = [376, 600, 752, 1200];
const sizes = '(min-width: 1024px) 376px, (min-width: 640px) calc(50vw - 40px), calc(100vw - 40px)';

/**
 * Un GIF transparent d'un pixel, en `poster`.
 *
 * Sans attribut `poster` du tout, Chrome peint un rectangle noir opaque tant
 * que la vidéo n'a aucune image décodée, et ce rectangle couvre l'affiche
 * posée dessous. Avec un poster transparent, il n'a plus rien à peindre et
 * l'affiche se voit, y compris sans JavaScript, où la vidéo ne démarre jamais
 * d'elle-même.
 */
const BLANK_POSTER =
	'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<div class:list={[frame, 'border-ink bg-ground-deep relative w-full overflow-hidden border-b-2']}>
	{
		video ? (
			<Fragment>
				{/*
				 * L'affiche est une image à part, sous la vidéo, et non l'attribut
				 * `poster` : `poster` est toujours chargé au premier paint, même avec
				 * `preload="none"`. Les quatre affiches pesaient ainsi 120 Ko dans la
				 * fenêtre initiale pour des cartes situées trois écrans plus bas, et
				 * elles se disputaient la bande passante avec la police. En `<img>`,
				 * le `loading="lazy"` natif s'en charge, sans JavaScript, et le
				 * pipeline d'images sert de l'AVIF à la taille réellement affichée.
				 * La vidéo la recouvre dès qu'elle démarre : même cadre, même
				 * `object-contain`.
				 */}
				{poster && (
					<Picture
						src={poster}
						alt=""
						formats={['avif', 'webp']}
						widths={widths}
						sizes={sizes}
						class="absolute inset-0 size-full object-contain"
						loading={priority ? 'eager' : 'lazy'}
						fetchpriority={priority ? 'high' : 'auto'}
					/>
				)}
				<video
					src={video}
					poster={BLANK_POSTER}
					aria-label={alt}
					class="absolute inset-0 size-full object-contain"
					loop
					muted
					playsinline
					preload="none"
					data-lazy-play
				/>
				{/*
				 * Un aperçu qui boucle sans fin à côté du texte doit pouvoir être
				 * arrêté (WCAG 2.2.2). Le bouton affiche ce que la pression fera, et
				 * c'est l'état réel de la vidéo qui le pilote, pas une intention : un
				 * `play()` refusé par le navigateur laisse donc « Lire » affiché.
				 * Masqué sans JavaScript, où la vidéo ne démarre jamais.
				 */}
				<button
					type="button"
					data-video-toggle
					data-paused
					aria-label="Lire l’aperçu"
					class="media-toggle plate pressable border-ink bg-ink text-enamel-face hover:bg-indigo absolute right-2 bottom-2 size-10 items-center justify-center border-2"
				>
					<span data-icon="pause">
						<Icon name="pause" size={16} />
					</span>
					<span data-icon="play">
						<Icon name="play" size={16} />
					</span>
				</button>
			</Fragment>
		) : isLocalImage(image) ? (
			<Picture
				src={image}
				alt={alt}
				formats={['avif', 'webp']}
				widths={widths}
				sizes={sizes}
				class="absolute inset-0 size-full object-contain"
				loading={priority ? 'eager' : 'lazy'}
				fetchpriority={priority ? 'high' : 'auto'}
			/>
		) : (
			<img
				src={image}
				alt={alt}
				class="absolute inset-0 size-full object-contain"
				loading={priority ? 'eager' : 'lazy'}
			/>
		)
	}
</div>
