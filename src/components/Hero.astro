---
import { Picture } from 'astro:assets';
import CopySwap from './CopySwap.astro';
import Icon from './Icon.astro';
import { profile, headlineMetrics, socials, cv } from '~/data/profile';
import { projects } from '~/data/projects';
import { projectAnchor } from '~/lib/anchor';

/** Les trois enseignes de coin, nommées dans le premier viewport. Un
 *  recruteur doit pouvoir citer une chose qu'il a construite, pas seulement
 *  réciter quatre chiffres. */
const featured = projects.filter((p) => p.featured);
---

<section id="accueil" class="border-ink relative border-b-2">
	<div class="mx-auto w-full max-w-[1240px] px-5 pt-8 pb-0 sm:px-8 lg:pt-10">
		{
			/* Une seule planche, trois zones : l'identité (portrait + plaque de
			   lieu), le nom, et le corps (rôle, statut, promesse, actions).

			   Sur mobile l'identité ouvre la planche, au-dessus du nom ; à partir de
			   `lg` elle rejoint la colonne de droite, sous le lettrage, alignée en
			   bas sur le corps. Les zones placent un seul élément aux deux endroits.
			   Avant, deux portraits coexistaient, l'un masqué à chaque largeur mais
			   téléchargé quand même, en `fetchpriority="high"`, contre l'image qui
			   comptait. Dans le DOM le titre vient en premier, et c'est l'ordre que
			   lit un lecteur d'écran. */
		}
		<div class="hero-board">
			{
				/* Le nom occupe son panneau sur une seule ligne, plafonné à 6rem ; la
			    place qui reste à sa droite porte les trois produits nommés, de sorte
			    que le panneau soit rempli d'un bord à l'autre. En dessous de xl le
			    nom remplit déjà sa mesure et il n'y a pas de vide à combler. */
			}
			<div
				class="[grid-area:name] xl:grid xl:grid-cols-[auto_minmax(0,1fr)] xl:items-center xl:gap-10"
			>
				<h1 class="lettering text-marquee text-ink xl:whitespace-nowrap">{profile.name}</h1>

				<ul
					aria-label="Projets en vedette"
					class="plate border-ink bg-ground hidden border-2 xl:block"
				>
					{
						featured.map((project) => (
							<li class="border-ink-line not-first:border-t-2">
								<a
									href={`#${projectAnchor(project)}`}
									class="group hover:bg-chrome active:bg-chrome block px-4 py-2.5 transition-colors duration-200"
								>
									<span class="admin text-ink-3 group-hover:text-ink group-active:text-ink block">
										{project.category === 'Projets Web' ? 'Web' : 'Jeu vidéo'}
									</span>
									<span class="stretch-sign text-small text-ink mt-0.5 block font-extrabold">
										{project.title}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="mt-8 [grid-area:body] lg:self-end">
				<p
					class="plate stretch-sign bg-indigo text-sign text-enamel-face inline-block px-3.5 py-2 font-extrabold"
				>
					{profile.role}
				</p>

				{
					/* Le statut, pas un sur-titre : il est sous le rôle, pas au-dessus d'un
					    titre. Il répond à « où il en est » sans que le lecteur déduise. */
				}
				<ul class="admin text-ink-3 mt-3 flex flex-wrap items-center gap-x-2 gap-y-1">
					{
						profile.status.map((fact, i) => (
							<Fragment>
								{i > 0 && (
									<li aria-hidden="true" class="text-ink-3">
										·
									</li>
								)}
								<li>{fact}</li>
							</Fragment>
						))
					}
				</ul>

				<p class="text-body text-ink-2 mt-4 max-w-[46ch]">{profile.tagline}</p>

				<div class="mt-6 flex flex-wrap items-center gap-2.5">
					<a
						href={cv.href}
						download={cv.filename}
						class="plate pressable stretch-sign bg-vermilion text-sign text-enamel-face hover:bg-vermilion-deep inline-flex items-center gap-2.5 px-5 py-3 font-extrabold"
					>
						<Icon name="download" size={17} />
						{cv.label}
					</a>

					{
						socials.map((social) => (
							<a
								href={social.href}
								target={social.id === 'email' ? null : '_blank'}
								rel={social.id === 'email' ? null : 'noopener noreferrer'}
								data-copy-email={social.id === 'email' ? '' : null}
								class="plate pressable border-ink bg-ground text-small text-ink hover:bg-chrome inline-flex items-center gap-2 border-2 px-3.5 py-2.5 font-bold"
							>
								<Icon name={social.id === 'email' ? 'mail' : social.id} size={16} />
								{social.id === 'email' ? (
									<CopySwap copied="Copiée">{social.label}</CopySwap>
								) : (
									<span>{social.label}</span>
								)}
							</a>
						))
					}
				</div>
			</div>

			<div
				class="mb-5 flex items-center gap-4 [grid-area:id] lg:mt-8 lg:mb-0 lg:flex-col lg:items-start lg:gap-3 lg:self-end"
			>
				{
					/* `loading="eager"` est explicite : `<Picture>` pose `loading="lazy"`
					   par défaut, ce qui contredit le `fetchpriority` et diffère une image
					   du premier viewport.

					   La densité va jusqu'à 3 ici et nulle part ailleurs : c'est un
					   visage, et la plupart des téléphones sont en DPR 3. Les largeurs
					   candidates couvrent les deux tailles affichées (68 et 184 px, dans
					   leur cadre de 2 px) en 1x, 2x et 3x. */
				}
				<div
					class="plate bg-indigo border-ink size-[72px] shrink-0 overflow-hidden border-2 lg:size-[188px]"
				>
					<Picture
						src={profile.photo}
						alt={profile.photoAlt}
						formats={['avif', 'webp']}
						widths={[68, 136, 184, 204, 368, 552]}
						sizes="(min-width: 1024px) 184px, 68px"
						class="size-full object-cover"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<p class="admin text-ink-3 flex items-center gap-1.5">
					<Icon name="pin" size={13} />
					{profile.location}
				</p>
			</div>
		</div>
	</div>

	{
		/* Le bandeau de preuve. Chiffres jaunes sur émail indigo : c'est la seule
	    région de la page qui existe pour être lue en trois secondes.

	    Les cellules reprennent la marge du conteneur (`px-5`, puis `sm:px-8`) :
	    avec `sm:px-6`, « 2 000 » commençait 8 px à gauche du nom au-dessus, et
	    la seule ligne verticale de la planche se cassait là. */
	}
	<div class="border-ink bg-indigo mt-8 border-t-2 lg:mt-12">
		<dl
			class="divide-indigo-deep mx-auto grid w-full max-w-[1240px] grid-cols-1 divide-x-0 divide-y-2 sm:grid-cols-3 sm:divide-x-2 sm:divide-y-0"
		>
			{
				headlineMetrics.map((metric) => (
					<div class="flex items-baseline gap-3 px-5 py-4 sm:block sm:px-8 sm:py-7">
						{/* Sur mobile la valeur et son libellé tiennent sur une ligne, comme
						    une rangée de tableau d'affichage : trois cellules empilées en
						    colonne coûteraient un tiers du premier viewport. */}
						<dt class="sr-only">{metric.label}</dt>
						<dd class="contents sm:block">
							<span class="lettering nums-tabular text-plate text-chrome sm:text-plate-xl min-w-[3.4em] sm:block sm:min-w-0">
								{metric.value}
							</span>
							<span class="admin text-enamel-face/90 sm:mt-1.5 sm:block">{metric.label}</span>
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
