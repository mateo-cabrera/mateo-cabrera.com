---
/**
 * L'en-tête de rubrique.
 *
 * Ni sur-titre ni numéro de section : le titre porte son propre poids, et une
 * séquence 01→06 ne dit rien au lecteur que la note de comptage ne dise déjà
 * mieux.
 *
 * La rangée passe à la ligne plutôt que de pousser : à 320 px, « Compétences »
 * en lettrage de plaque plus « 32 technologies » faisaient 354 px, et la page
 * entière défilait de côté. La note descend sous le titre, elle ne déborde pas.
 *
 * `tone="enamel"` est la même rubrique posée sur un champ d'émail (le
 * comptoir) : le titre hérite du lettrage de la section, le filet et la note
 * passent à l'émail.
 */
interface Props {
	title: string;
	note?: string;
	tone?: 'ink' | 'enamel';
}

const { title, note, tone = 'ink' } = Astro.props;
const enamel = tone === 'enamel';
---

<div
	class:list={[
		'mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-1 border-b-2 pb-3 sm:mb-10',
		enamel ? 'border-enamel-face/35' : 'border-ink'
	]}
>
	<h2 class:list={['lettering text-plate', !enamel && 'text-ink']}>{title}</h2>
	{
		note && (
			<p class:list={['admin shrink-0 pb-1', enamel ? 'text-enamel-face/90' : 'text-ink-3']}>
				{note}
			</p>
		)
	}
</div>
